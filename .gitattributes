# Normalize line endings to LF in the repository; Git still checks out
# using the platform's native line ending unless core.autocrlf is set.
* text=auto eol=lf

# Explicit text sources
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.hintrc text eol=lf

# Windows batch/cmd scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — never diff/merge as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
