# See https://help.github.com/ignore-files/ for more about ignoring files.

# Dependencies
/node_modules

# Build output
/dist
/.cache
/.pnp
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Runtime data
/tmp
/cache

# Logs
/logs
*.log

# Cypress generated artifacts (reports, videos, screenshots, downloads) —
# none are currently produced/committed, added ahead of Phase 5's first
# real run so it doesn't accidentally commit them.
cypress/reports/
cypress/videos/
cypress/screenshots/
cypress/downloads/
cypress/test-results/

# Editor/IDE specific
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw*

# OS junk
.DS_Store
Thumbs.db

# gitleaks scratch/report files (generated by the pre-commit hook / manual runs)
gitleaks-report.json
.gitleaks-staged-tmp/