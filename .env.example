# qa-m-a — environment variables
#
# Today, no code anywhere in this repo reads process.env or Cypress.env()
# (confirmed by search: `grep -rn "process.env|Cypress.env|CYPRESS_"`,
# zero matches outside node_modules). This file exists per the Docker
# standard regardless, as placeholders only, anticipating the Cypress
# Cloud wiring the project's own `projectId` (cypress.config.js) implies
# but does not yet use — a future phase may wire CI to record runs.
#
# Never fill these with real values in a committed file. Real values come
# only from a secret manager / CI environment-scoped secrets / local
# untracked .env (gitignored) — never from this file.

# Cypress Cloud project id already configured in cypress.config.js
# ("6b645r") — listed here only as a placeholder in case a future phase
# wires it through the environment instead of the committed config file.
CYPRESS_PROJECT_ID=

# Cypress Cloud record key — NOT currently used by any script in this
# repo (unlike udemy_cypress_13.6.6's "dashboard:cy" script). Placeholder
# only, for the same anticipated future wiring.
CYPRESS_RECORD_KEY=
